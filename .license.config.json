{
	"license": ".license.template",
	"licenseFormats": {
		"js|ts": {
			"eachLine": {
				"prepend": "// "
			}
		}
	},
	"ignoreFile": ".gitignore",
	"ignore": [
		".github/**/*",
		".husky/**/*",
		"fixtures/*",
		"patches/*",
		"commitlint.config.cjs",
		"stryker.config.*",
		"LICENSE",
		".license.template",
		"**/.gitignore",
		"**/.npmrc",
		"**/*.fuzz.js",
		"**/*.perf.js",
		"**/*.test.js",
		"**/*.cjs",
		"**/*.md",
		"**/*.yml",
		"**/*.yaml",
		"**/.DS_Store",
		"**/*.sh",
		"**/*.ftl"
	]
}
